---
import { and, desc, eq, like, or } from 'drizzle-orm';
import { getDB } from '../db';
import { articles, topics } from '../db/schema';
import BaseLayout from '../layouts/BaseLayout.astro';

const db = getDB();
const q = (Astro.url.searchParams.get('q') || '').trim();

let articleHits: any[] = [];
let topicHits: any[] = [];

if (q) {
  const kw = `%${q}%`;
  articleHits = await db
    .select()
    .from(articles)
    .where(
      and(
        eq(articles.published, 1),
        or(like(articles.title, kw), like(articles.summary, kw), like(articles.content, kw), like(articles.tags, kw)),
      ),
    )
    .orderBy(desc(articles.publishedAt))
    .limit(30);

  topicHits = await db
    .select()
    .from(topics)
    .where(or(like(topics.title, kw), like(topics.description, kw)))
    .orderBy(desc(topics.voteCount))
    .limit(30);
}

const total = articleHits.length + topicHits.length;
---

<BaseLayout title={q ? `搜索 ${q}` : '全站搜索'} description="搜索出海社区的文章与话题">
  <div class="container" style="padding-block:var(--space-8); max-width:var(--container-reading);">
    <h1 style="margin:0 0 var(--space-5); font-size:var(--font-size-24); font-weight:800;">全站搜索</h1>

    <form method="get" role="search">
      <div class="form-field">
        <label class="form-label" for="q">关键词</label>
        <div style="display:flex; gap:var(--space-2);">
          <input class="form-input" id="q" name="q" value={q} placeholder="输入关键词，搜索文章和话题" autofocus style="flex:1;" />
          <button class="btn btn--primary" type="submit">搜索</button>
        </div>
      </div>
    </form>

    <p style="margin:0 0 var(--space-6); font-size:var(--font-size-14); color:var(--color-text-muted);">
      {q ? `「${q}」共 ${total} 条结果` : '输入关键词开始搜索。'}
    </p>

    {
      articleHits.length ? (
        <section style="margin-bottom:var(--space-8);">
          <h2 style="margin:0 0 var(--space-3); font-size:var(--font-size-18); font-weight:700;">文章（{articleHits.length}）</h2>
          <ul style="list-style:none; margin:0; padding:0;">
            {
              articleHits.map((a) => (
                <li style="padding:var(--space-3) 0; border-bottom:1px solid var(--color-border-subtle);">
                  <a href={`/articles/${a.slug}`} style="color:var(--color-text); font-weight:500;">{a.title}</a>
                  {a.summary ? <div class="line-clamp-2" style="margin-top:var(--space-1); font-size:var(--font-size-13); color:var(--color-text-muted);">{a.summary}</div> : null}
                </li>
              ))
            }
          </ul>
        </section>
      ) : null
    }

    {
      topicHits.length ? (
        <section>
          <h2 style="margin:0 0 var(--space-3); font-size:var(--font-size-18); font-weight:700;">话题（{topicHits.length}）</h2>
          <ul style="list-style:none; margin:0; padding:0;">
            {
              topicHits.map((t) => (
                <li style="display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); padding:var(--space-3) 0; border-bottom:1px solid var(--color-border-subtle);">
                  <a href="/topics" style="color:var(--color-text); font-weight:500;">{t.title}</a>
                  <span style="flex-shrink:0; font-size:var(--font-size-13); color:var(--color-text-muted); font-variant-numeric:tabular-nums;">{t.voteCount} 票</span>
                </li>
              ))
            }
          </ul>
        </section>
      ) : null
    }

    {
      q && !total ? (
        <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14); padding-block:var(--space-8);">
          没有找到相关内容，换个关键词试试。
        </div>
      ) : null
    }
  </div>
</BaseLayout>
