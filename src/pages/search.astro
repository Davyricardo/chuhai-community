---
import { and, desc, eq, like, or } from 'drizzle-orm';
import { getDB } from '../db';
import { articles, topics } from '../db/schema';
import BaseLayout from '../layouts/BaseLayout.astro';

const db = getDB();
const q = (Astro.url.searchParams.get('q') || '').trim();

let articleHits: any[] = [];
let topicHits: any[] = [];

if (q) {
  const kw = `%${q}%`;
  articleHits = await db
    .select()
    .from(articles)
    .where(
      and(
        eq(articles.published, 1),
        or(like(articles.title, kw), like(articles.summary, kw), like(articles.content, kw), like(articles.tags, kw)),
      ),
    )
    .orderBy(desc(articles.publishedAt))
    .limit(30);

  topicHits = await db
    .select()
    .from(topics)
    .where(or(like(topics.title, kw), like(topics.description, kw)))
    .orderBy(desc(topics.voteCount))
    .limit(30);
}

const total = articleHits.length + topicHits.length;
---

<BaseLayout title={q ? `搜索：${q}` : '全站搜索'} description="即时检索 ChatSI 站内的全部实战博文与社区共创话题">
  <div class="container search-page-container">
    <header class="search-page-header animate-in">
      <h1 class="search-page-title">全站智能检索</h1>
      <p class="search-page-desc">一站式搜索深度实战文章、案例分析与社区话题征集池</p>

      <form class="glass-pill search-bar-pill" method="get" role="search">
        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <input
          class="search-input"
          id="q"
          name="q"
          value={q}
          placeholder="输入关键词检索（如 Docker、Claude、Workers、架构）..."
          aria-label="输入关键词"
        />
        <button class="btn btn--primary" type="submit">搜索</button>
      </form>

      {q && (
        <div class="search-stats-badge">
          <span>关键词「{q}」共匹配到 {total} 项结果</span>
        </div>
      )}
    </header>

    {
      articleHits.length ? (
        <section class="results-section animate-in">
          <div class="section-title-row">
            <span class="section-icon">📖</span>
            <h2 class="section-title">相关实战博文 ({articleHits.length})</h2>
          </div>
          <div class="results-list">
            {
              articleHits.map((a) => (
                <article class="glass-card liquid-glow result-card">
                  <h3 class="result-title">
                    <a href={`/articles/${a.slug}`} class="result-link">{a.title}</a>
                  </h3>
                  {a.summary && <p class="result-summary line-clamp-2">{a.summary}</p>}
                </article>
              ))
            }
          </div>
        </section>
      ) : null
    }

    {
      topicHits.length ? (
        <section class="results-section animate-in">
          <div class="section-title-row">
            <span class="section-icon">💡</span>
            <h2 class="section-title">相关社区话题 ({topicHits.length})</h2>
          </div>
          <div class="results-list">
            {
              topicHits.map((t) => (
                <article class="glass-card liquid-glow result-card topic-result-card">
                  <div>
                    <h3 class="result-title">
                      <a href="/topics" class="result-link">{t.title}</a>
                    </h3>
                    {t.description && <p class="result-summary line-clamp-2">{t.description}</p>}
                  </div>
                  <div class="topic-votes-badge">
                    ▲ {t.voteCount} 票支持
                  </div>
                </article>
              ))
            }
          </div>
        </section>
      ) : null
    }

    {
      q && !total ? (
        <div class="glass-card empty-search-card animate-in">
          <div class="empty-icon">🔍</div>
          <p class="empty-title">未发现匹配「{q}」的内容</p>
          <p class="empty-sub">你可以更换简短的技术词汇，或者直接前往话题社区发起该选题。</p>
          <div style="margin-top:var(--space-4);">
            <a href="/topics" class="btn btn--primary">去社区发起该话题</a>
          </div>
        </div>
      ) : null
    }
  </div>
</BaseLayout>

<style>
  .search-page-container {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
    max-width: var(--container-reading);
  }
  .search-page-header {
    text-align: center;
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .search-page-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-28);
    font-weight: 800;
    letter-spacing: -0.025em;
    background: var(--gradient-brand-text);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .search-page-desc {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-14);
    color: var(--color-text-secondary);
  }
  .search-bar-pill {
    display: flex;
    align-items: center;
    width: 100%;
    padding: 6px 8px 6px 16px;
    transition: all var(--duration-fast);
  }
  .search-bar-pill:focus-within {
    box-shadow: 0 12px 36px rgba(0, 113, 227, 0.16), 0 0 0 3px rgba(0, 113, 227, 0.25);
    border-color: var(--color-primary-border);
  }
  .search-icon {
    color: var(--color-text-muted);
    flex-shrink: 0;
    margin-right: var(--space-2);
  }
  .search-input {
    flex: 1;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    font-size: var(--font-size-15);
    color: var(--color-text);
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
  }
  .search-input:focus,
  .search-input:focus-visible {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
  }
  .search-stats-badge {
    margin-top: var(--space-4);
    font-size: var(--font-size-13);
    color: var(--color-text-muted);
  }

  .results-section {
    margin-bottom: var(--space-8);
  }
  .section-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .section-icon {
    font-size: 1.25rem;
  }
  .section-title {
    margin: 0;
    font-size: var(--font-size-18);
    font-weight: 700;
  }
  .results-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .result-card {
    padding: var(--space-5);
  }
  .result-title {
    margin: 0 0 var(--space-1);
    font-size: var(--font-size-16);
    font-weight: 700;
  }
  .result-link {
    color: var(--color-text);
  }
  .result-link:hover {
    color: var(--color-primary);
  }
  .result-summary {
    margin: 0;
    font-size: var(--font-size-13);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  .topic-result-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .topic-votes-badge {
    flex-shrink: 0;
    font-size: var(--font-size-12);
    font-weight: 600;
    color: var(--color-primary-text);
    background: var(--color-primary-subtle);
    border: 1px solid var(--color-primary-border);
    padding: 4px 10px;
    border-radius: var(--radius-full);
  }

  .empty-search-card {
    padding: var(--space-12) var(--space-6);
    text-align: center;
  }
  .empty-icon {
    font-size: 2rem;
    margin-bottom: var(--space-3);
  }
  .empty-title {
    margin: 0 0 var(--space-2);
    font-size: var(--font-size-16);
    font-weight: 700;
  }
  .empty-sub {
    margin: 0;
    font-size: var(--font-size-14);
    color: var(--color-text-muted);
  }
</style>
