---
import { desc } from 'drizzle-orm';
import { getDB } from '../../db';
import { articles } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';

const db = getDB();
const user = Astro.locals.user ?? null;

if (!user) return Astro.redirect('/auth/login');
if (user.role !== 'admin') return Astro.redirect('/');

const list = await db.select().from(articles).orderBy(desc(articles.createdAt)).limit(50);
---

<BaseLayout title="后台" description="内容管理后台">
  <div class="container" style="padding-block:var(--space-8);">
    <div style="display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:var(--space-3); margin-bottom:var(--space-6);">
      <h1 style="margin:0; font-size:var(--font-size-24); font-weight:800;">后台</h1>
      <span style="font-size:var(--font-size-13); color:var(--color-text-muted);">{user.displayName}（管理员）</span>
    </div>

    <!-- 发布表单：桌面双列，手机单列 -->
    <section class="card" style="margin-bottom:var(--space-8);">
      <h2 style="margin:0 0 var(--space-4); font-size:var(--font-size-18); font-weight:700;">发布文章</h2>
      <form id="form" novalidate>
        <div class="admin-grid">
          <div class="form-field">
            <label class="form-label" for="a-title">标题（必填）</label>
            <input class="form-input" id="a-title" name="title" maxlength="120" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="a-slug">slug（留空自动生成）</label>
            <input class="form-input" id="a-slug" name="slug" placeholder="my-first-post" pattern="[a-z0-9-]*" style="font-family:var(--font-mono); font-size:var(--font-size-14);" />
          </div>
          <div class="form-field">
            <label class="form-label" for="a-tags">标签，逗号分隔</label>
            <input class="form-input" id="a-tags" name="tags" placeholder="工具, Stripe" />
          </div>
          <div class="form-field">
            <label class="form-label" for="a-link">外链 URL（可选）</label>
            <input class="form-input" id="a-link" name="link" type="url" placeholder="https://mp.weixin.qq.com/…" />
          </div>
          <div class="form-field" style="grid-column:1 / -1;">
            <label class="form-label" for="a-summary">摘要（可选）</label>
            <input class="form-input" id="a-summary" name="summary" maxlength="200" />
          </div>
          <div class="form-field" style="grid-column:1 / -1;">
            <label class="form-label" for="a-content">正文（可选，支持换行）</label>
            <textarea class="form-textarea" id="a-content" name="content" style="min-height:11rem;"></textarea>
          </div>
        </div>
        <div style="display:flex; align-items:center; gap:var(--space-3);">
          <button class="btn btn--primary" type="submit">发布</button>
          <span id="msg" style="font-size:var(--font-size-13);"></span>
        </div>
      </form>
    </section>

    <!-- 文章表格：手机端横向滚动 -->
    <section>
      <h2 style="margin:0 0 var(--space-3); font-size:var(--font-size-18); font-weight:700;">全部文章（{list.length}）</h2>
      {
        list.length ? (
          <div class="table-wrap">
            <table class="data-table">
              <thead>
                <tr><th>标题</th><th>slug</th><th>状态</th><th>时间</th></tr>
              </thead>
              <tbody>
                {list.map((a) => (
                  <tr>
                    <td><a href={`/articles/${a.slug}`}>{a.title}</a></td>
                    <td style="font-family:var(--font-mono); font-size:var(--font-size-13); color:var(--color-text-muted);">{a.slug}</td>
                    <td>
                      {a.published ? <span class="badge badge--done">已发布</span> : <span class="badge badge--planned">草稿</span>}
                    </td>
                    <td style="color:var(--color-text-muted); font-variant-numeric:tabular-nums;">{new Date(a.createdAt).toISOString().slice(0, 10)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14); padding-block:var(--space-6);">
            还没有文章
          </div>
        )
      }
    </section>
  </div>

  <script>
    const form = document.getElementById('form') as HTMLFormElement;
    const msg = document.getElementById('msg')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span class="btn__spinner"></span>发布中…';
      msg.textContent = '';
      msg.style.color = '';

      const payload = {
        title: (form.title as HTMLInputElement).value.trim(),
        slug: (form.slug as HTMLInputElement).value.trim(),
        summary: (form.summary as HTMLInputElement).value.trim(),
        content: (form.content as HTMLTextAreaElement).value.trim(),
        link: (form.link as HTMLInputElement).value.trim(),
        tags: (form.tags as HTMLInputElement).value.trim(),
      };

      try {
        const res = await fetch('/api/articles', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then((r) => r.json());

        if (res.ok) {
          msg.textContent = '发布成功';
          msg.style.color = 'var(--color-success)';
          setTimeout(() => location.reload(), 600);
        } else {
          msg.textContent = res.error || '发布失败';
          msg.style.color = 'var(--color-danger)';
        }
      } catch {
        msg.textContent = '网络异常，请稍后重试';
        msg.style.color = 'var(--color-danger)';
      } finally {
        btn.disabled = false;
        btn.innerHTML = original;
      }
    });
  </script>
</BaseLayout>

<style>
  .admin-grid { display: grid; grid-template-columns: 1fr; gap: 0 var(--space-5); }
  @media (min-width: 768px) {
    .admin-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
