---
import { and, desc, eq, like } from 'drizzle-orm';
import { getDB } from '../../db';
import { articles } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const db = getDB();
const active = (Astro.url.searchParams.get('tag') || '').trim();

// 工具推荐：后台发布文章时标签带「工具」即可出现在这里
const all = await db
  .select()
  .from(articles)
  .where(and(eq(articles.published, 1), like(articles.tags, '%工具%')))
  .orderBy(desc(articles.publishedAt))
  .limit(50);

// 从工具类文章提取除「工具」外的标签作为分类筛选
const tagSet = new Map<string, number>();
for (const a of all) {
  let tags: string[] = [];
  try {
    tags = typeof a.tags === 'string' ? JSON.parse(a.tags) : (a.tags || []);
  } catch {
    tags = [];
  }
  if (Array.isArray(tags)) {
    for (const t of tags) {
      if (t === '工具') continue;
      tagSet.set(t, (tagSet.get(t) || 0) + 1);
    }
  }
}
const categories = [...tagSet.entries()].sort((a, b) => b[1] - a[1]).slice(0, 10);

const list = active ? all.filter((a) => (a.tags || '').includes(active)) : all;
---

<BaseLayout title="工具推荐" description="出海常用的建站、支付、SEO、AI 工具整理">
  <div class="container" style="padding-block:var(--space-8);">
    <h1 style="margin:0 0 var(--space-2); font-size:var(--font-size-24); font-weight:800;">工具推荐</h1>
    <p style="margin:0 0 var(--space-6); font-size:var(--font-size-14); color:var(--color-text-muted); max-width:var(--container-reading);">
      出海常用的建站、支付、SEO、AI 工具整理。后台发布文章时把标签写成「工具」即可收录到这里。
    </p>

    {
      categories.length > 0 && (
        <nav aria-label="工具分类" style="display:flex; flex-wrap:wrap; gap:var(--space-2); margin-bottom:var(--space-6);">
          <a href="/tools" class="tag" style={!active ? 'background-color:var(--color-primary-subtle); color:var(--color-primary-text); border-color:var(--color-primary-border); font-weight:600;' : ''}>
            全部 <span style="color:var(--color-text-muted); margin-left:var(--space-1);">{all.length}</span>
          </a>
          {categories.map(([tag, count]) => (
            <a href={`/tools?tag=${encodeURIComponent(tag)}`} class="tag" style={active === tag ? 'background-color:var(--color-primary-subtle); color:var(--color-primary-text); border-color:var(--color-primary-border); font-weight:600;' : ''}>
              {tag} <span style="color:var(--color-text-muted); margin-left:var(--space-1);">{count}</span>
            </a>
          ))}
        </nav>
      )
    }

    {
      list.length ? (
        <div class="grid-cards-3">
          {list.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14); padding-block:var(--space-8);">
          {active ? `「${active}」分类下暂无工具` : '还没有工具类文章。去后台发布一篇，标签写「工具」。'}
        </div>
      )
    }
  </div>
</BaseLayout>
