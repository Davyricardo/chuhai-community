---
import { desc, eq } from 'drizzle-orm';
import { getDB } from '../db';
import { articles, topics } from '../db/schema';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

const db = getDB();
const user = Astro.locals.user ?? null;

const latest = await db
  .select()
  .from(articles)
  .where(eq(articles.published, 1))
  .orderBy(desc(articles.publishedAt))
  .limit(8);

const hotTopics = await db.select().from(topics).orderBy(desc(topics.voteCount)).limit(5);

// 从最新文章提取去重热门标签
const tagSet = new Map<string, number>();
for (const a of latest) {
  let tags: string[] = [];
  try {
    tags = typeof a.tags === 'string' ? JSON.parse(a.tags) : (a.tags || []);
  } catch {
    tags = [];
  }
  if (Array.isArray(tags)) {
    for (const t of tags) tagSet.set(t, (tagSet.get(t) || 0) + 1);
  }
}
const hotTags = [...tagSet.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const statusLabel: Record<string, string> = { open: '征集中', planned: '规划中', done: '已完成' };
---

<BaseLayout title="首页" description="出海实战分享、话题投票与工具推荐社区">
  <!-- Hero -->
  <section style="background:var(--gradient-hero-bg); border-bottom:1px solid var(--color-border);">
    <div class="container" style="padding-block:var(--space-12);">
      <h1 style="margin:0 0 var(--space-3); font-size:var(--font-size-30); line-height:var(--leading-tight); font-weight:800; background:var(--gradient-brand-text); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:var(--color-primary-text);">
        出海实战 · 少走弯路
      </h1>
      <p style="margin:0 0 var(--space-6); font-size:var(--font-size-16); color:var(--color-text-secondary); max-width:var(--container-reading);">
        面向 AI 产品出海与独立开发者的中文社区：真实踩坑记录、工具横评、话题投票决定下一篇文章写什么。
      </p>
      {
        hotTags.length > 0 && (
          <nav aria-label="热门标签" style="display:flex; flex-wrap:wrap; gap:var(--space-2);">
            {hotTags.map(([tag, count]) => (
              <a href={`/articles?q=${encodeURIComponent(tag)}`} class="tag">
                #{tag} <span style="color:var(--color-text-muted); margin-left:var(--space-1);">{count}</span>
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </section>

  <div class="container" style="padding-block:var(--space-8);">
    <div class="layout-community">
      <!-- 左：最新文章 -->
      <section aria-labelledby="latest-title">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:var(--space-4); margin-bottom:var(--space-4);">
          <h2 id="latest-title" style="margin:0; font-size:var(--font-size-18); font-weight:700;">最新文章</h2>
          <a href="/articles" style="font-size:var(--font-size-13);">查看全部 →</a>
        </div>

        {
          latest.length ? (
            <div class="feed-grid">
              {latest.map((a) => <ArticleCard article={a} />)}
            </div>
          ) : (
            <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14);">
              还没有文章，去后台发布第一篇吧。
            </div>
          )
        }
      </section>

      <!-- 右：热门话题 + 征集 CTA -->
      <aside aria-label="侧边栏" style="display:flex; flex-direction:column; gap:var(--space-5);">
        <section class="card" style="padding:var(--space-5);">
          <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:var(--space-4);">
            <h2 style="margin:0; font-size:var(--font-size-16); font-weight:700;">热门话题</h2>
            <a href="/topics" style="font-size:var(--font-size-12); color:var(--color-text-muted);">全部</a>
          </div>
          {
            hotTopics.length ? (
              <ul style="list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:var(--space-3);">
                {hotTopics.map((t) => (
                  <li style="display:flex; align-items:flex-start; justify-content:space-between; gap:var(--space-3);">
                    <a href="/topics" style="color:var(--color-text); font-size:var(--font-size-14); line-height:var(--leading-snug); font-weight:500;">{t.title}</a>
                    <span style="flex-shrink:0; display:flex; align-items:center; gap:var(--space-2);">
                      <span class="badge badge--{t.status}">{statusLabel[t.status] || t.status}</span>
                      <span style="font-size:var(--font-size-13); color:var(--color-text-muted); font-variant-numeric:tabular-nums;">{t.voteCount}</span>
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p style="margin:0; font-size:var(--font-size-14); color:var(--color-text-muted);">还没有话题，去 /topics 提交一个。</p>
            )
          }
        </section>

        <section style="background:var(--gradient-cta-card); border:1px solid var(--color-primary-border); border-radius:var(--radius-xl); padding:var(--space-5);">
          <h2 style="margin:0 0 var(--space-2); font-size:var(--font-size-16); font-weight:700;">下一篇文章写什么？</h2>
          <p style="margin:0 0 var(--space-4); font-size:var(--font-size-14); color:var(--color-text-secondary); line-height:var(--leading-normal);">
            提交你想了解的出海话题，票数最高的优先安排。
          </p>
          <a href="/topics" class="btn btn--primary">参与话题征集</a>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .feed-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 640px) { .feed-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
