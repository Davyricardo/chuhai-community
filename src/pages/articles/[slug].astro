---
import { eq } from 'drizzle-orm';
import { getDB } from '../../db';
import { articles } from '../../db/schema';
import { getSessionUser, sessionCookieName } from '../../lib/auth';

const { slug } = Astro.params;
const db = getDB();
const rows = await db.select().from(articles).where(eq(articles.slug, slug || '')).limit(1);
const article = rows[0];

if (!article || !article.published) {
  return Astro.redirect('/articles');
}

const user = await getSessionUser(db, Astro.cookies.get(sessionCookieName())?.value);
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{article.title} · CHUHAI</title>
    <meta name="description" content={article.summary || article.title} />
    <style>
      body { font-family: system-ui, sans-serif; max-width: 720px; margin: 0 auto; padding: 0 20px 60px; line-height: 1.7; }
      header { display: flex; align-items: center; justify-content: space-between; padding: 16px 0; border-bottom: 1px solid #eee; }
      nav a { margin-left: 14px; color: #374151; text-decoration: none; font-size: 14px; }
      h1 { font-size: 28px; margin: 32px 0 8px; }
      .meta { color: #9ca3af; font-size: 13px; margin-bottom: 24px; }
      .content { white-space: pre-wrap; }
      a.ext { color: #2563eb; }
      .back { display: inline-block; margin-top: 32px; color: #2563eb; text-decoration: none; font-size: 14px; }
    </style>
  </head>
  <body>
    <header>
      <a href="/" style="font-weight: 700; text-decoration: none; color: #111">CHUHAI</a>
      <nav>
        <a href="/articles">文章</a>
        <a href="/topics">话题</a>
        {user ? <a href="/admin">后台</a> : <a href="/auth/login">登录</a>}
      </nav>
    </header>

    <h1>{article.title}</h1>
    <div class="meta">{new Date(article.publishedAt).toISOString().slice(0, 10)}{article.tags ? ` · ${article.tags}` : ''}</div>

    {article.link ? <p><a class="ext" href={article.link} target="_blank" rel="noopener noreferrer">查看原文 →</a></p> : null}

    {article.content ? <div class="content">{article.content}</div> : null}

    <a class="back" href="/articles">← 返回文章列表</a>
  </body>
</html>
