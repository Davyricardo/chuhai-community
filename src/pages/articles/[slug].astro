---
import { eq } from 'drizzle-orm';
import { getDB } from '../../db';
import { articles } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';

const { slug } = Astro.params;
const db = getDB();
const rows = await db.select().from(articles).where(eq(articles.slug, slug || '')).limit(1);
const article = rows[0];

if (!article || !article.published) {
  return Astro.redirect('/articles');
}

const user = Astro.locals.user ?? null;
const dateStr = article.publishedAt ? new Date(article.publishedAt).toISOString().slice(0, 10) : '';
let tags: string[] = [];
try {
  tags = typeof article.tags === 'string' ? JSON.parse(article.tags) : (article.tags || []);
} catch {
  tags = [];
}
if (!Array.isArray(tags)) tags = [];
---

<BaseLayout title={article.title} description={article.summary || article.title}>
  <article class="container-reading" style="padding-block:var(--space-8);">
    <a href="/articles" style="font-size:var(--font-size-13); color:var(--color-text-muted);">← 返回文章列表</a>

    <header style="margin-top:var(--space-4);">
      <h1 style="margin:0 0 var(--space-3); font-size:var(--font-size-30); line-height:var(--leading-tight); font-weight:800;">{article.title}</h1>
      <div style="display:flex; flex-wrap:wrap; align-items:center; gap:var(--space-2); font-size:var(--font-size-13); color:var(--color-text-muted);">
        <time datetime={dateStr}>{dateStr}</time>
        {tags.map((t: string) => <a href={`/articles?q=${encodeURIComponent(t)}`} class="tag">#{t}</a>)}
      </div>
    </header>

    {
      article.link && (
        <div class="alert alert--info" style="margin-top:var(--space-5);">
          <div style="flex:1;">
            本文包含外部原文链接，点击前往原站点阅读完整内容。
          </div>
          <a class="btn btn--secondary" href={article.link} target="_blank" rel="noopener noreferrer" style="flex-shrink:0;">
            阅读原文 ↗
          </a>
        </div>
      )
    }

    {
      article.content ? (
        <div class="prose-cjk" style="margin-top:var(--space-6); white-space:pre-wrap;">
          {article.content}
        </div>
      ) : null
    }

    <!-- 评论区 -->
    <section id="comments" style="margin-top:var(--space-12); padding-top:var(--space-6); border-top:1px solid var(--color-border);">
      <h2 style="margin:0 0 var(--space-5); font-size:var(--font-size-18); font-weight:700;">评论</h2>
      <div id="clist" style="font-size:var(--font-size-14); color:var(--color-text-secondary);">加载中…</div>

      {
        user ? (
          <form id="cform" style="margin-top:var(--space-6);">
            <div class="form-field">
              <label class="form-label" for="cinput">说点什么…</label>
              <textarea class="form-textarea" id="cinput" maxlength="1000" placeholder="友善发言，理性讨论"></textarea>
            </div>
            <div class="turnstile-slot">
              <div class="cf-turnstile" data-sitekey="0x4AAAAAAFa6NXpqnS6MFmGQ" data-theme="auto"></div>
            </div>
            <div style="display:flex; align-items:center; gap:var(--space-3);">
              <button class="btn btn--primary" type="submit">发表评论</button>
              <span id="cmsg" style="font-size:var(--font-size-13); color:var(--color-danger);"></span>
            </div>
          </form>
        ) : (
          <p style="font-size:var(--font-size-14); color:var(--color-text-muted);">
            <a href="/auth/login">登录</a> 后可以评论。
          </p>
        )
      }
    </section>
  </article>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>
  <script define:vars={{ articleId: article.id }}>
    const listEl = document.getElementById('clist');
    const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    async function load() {
      try {
        const res = await fetch(`/api/comments?targetType=article&targetId=${encodeURIComponent(articleId)}`).then((r) => r.json());
        const items = res.comments || [];
        if (!items.length) {
          listEl.textContent = '还没有评论，来抢沙发。';
          listEl.style.color = 'var(--color-text-muted)';
          return;
        }
        listEl.style.color = 'var(--color-text-secondary)';
        listEl.innerHTML = items
          .map(
            (c) =>
              `<div style="padding:var(--space-3) 0; border-bottom:1px solid var(--color-border-subtle);">
                <div style="font-weight:600; font-size:var(--font-size-13); color:var(--color-text);">${esc(c.displayName)}</div>
                <div style="margin-top:var(--space-1); white-space:pre-wrap;">${esc(c.content)}</div>
              </div>`,
          )
          .join('');
      } catch (e) {
        listEl.textContent = '评论加载失败';
        listEl.style.color = 'var(--color-danger)';
      }
    }

    const form = document.getElementById('cform');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = document.getElementById('cinput');
        const msg = document.getElementById('cmsg');
        const content = input.value.trim();
        if (!content) {
          msg.textContent = '评论内容不能为空';
          return;
        }
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        msg.textContent = '';
        const res = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            targetType: 'article',
            targetId: articleId,
            content,
            turnstileToken: document.querySelector('[name="cf-turnstile-response"]')?.value || '',
          }),
        }).then((r) => r.json());
        btn.disabled = false;
        if (res.ok) {
          input.value = '';
          load();
        } else {
          msg.textContent = res.error || '发表失败';
        }
      });
    }

    load();
  </script>
</BaseLayout>
