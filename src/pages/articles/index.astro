---
import { and, desc, eq, like, or } from 'drizzle-orm';
import { getDB } from '../../db';
import { articles } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

const db = getDB();
const q = (Astro.url.searchParams.get('q') || '').trim();

let list: any[] = [];
try {
  list = q
    ? await db
        .select()
        .from(articles)
        .where(
          and(
            eq(articles.published, 1),
            or(like(articles.title, `%${q}%`), like(articles.summary, `%${q}%`), like(articles.tags, `%${q}%`)),
          ),
        )
        .orderBy(desc(articles.publishedAt))
        .limit(50)
    : await db
        .select()
        .from(articles)
        .where(eq(articles.published, 1))
        .orderBy(desc(articles.publishedAt))
        .limit(50);
} catch (e) {
  console.error('QUERY_ERROR', (e as Error)?.message, (e as Error)?.stack);
  Astro.response.status = 500;
}
---

<BaseLayout title={q ? `搜索：${q}` : '全部文章'} description="按关键词浏览 AI 与云服务实战文章">
  <div class="container" style="padding-block:var(--space-8);">
    <h1 style="margin:0 0 var(--space-2); font-size:var(--font-size-24); font-weight:800;">
      {q ? `搜索「${q}」` : '全部文章'}
    </h1>
    <p style="margin:0 0 var(--space-6); font-size:var(--font-size-14); color:var(--color-text-muted);">
      {list.length} 篇文章{q ? '匹配该关键词' : ''}
    </p>

    <form class="search" method="get" role="search">
      <label class="form-label" for="q" style="margin-bottom:var(--space-2);">搜索</label>
      <div style="display:flex; gap:var(--space-2);">
        <input class="form-input" id="q" name="q" value={q} placeholder="搜索文章标题、摘要、标签" style="flex:1;" />
        <button class="btn btn--primary" type="submit">搜索</button>
      </div>
    </form>

    {
      list.length ? (
        <div class="grid-cards-3 reveal">
          {list.map((a) => <ArticleCard article={a} />)}
        </div>
      ) : (
        <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14); padding-block:var(--space-8);">
          {q ? '没有匹配的文章，换个关键词试试' : '还没有文章'}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .search { margin-bottom: var(--space-6); }
</style>
