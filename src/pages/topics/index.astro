---
import { desc } from 'drizzle-orm';
import { getDB } from '../../db';
import { topics } from '../../db/schema';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../../components/TopicCard.astro';

const db = getDB();
const user = Astro.locals.user ?? null;
const list = await db.select().from(topics).orderBy(desc(topics.voteCount), desc(topics.createdAt)).limit(50);
---

<BaseLayout title="话题征集" description="投票选出你最想了解的出海话题，高票优先创作">
  <div class="container" style="padding-block:var(--space-8); max-width:var(--container-reading);">
    <h1 style="margin:0 0 var(--space-2); font-size:var(--font-size-24); font-weight:800;">话题征集</h1>
    <p style="margin:0 0 var(--space-6); font-size:var(--font-size-14); color:var(--color-text-muted);">
      投票选出你最想了解的方向，高票会优先创作。
    </p>

    {
      user ? (
        <form class="card" id="newTopic" style="margin-bottom:var(--space-6); padding:var(--space-5);">
          <div class="form-field">
            <label class="form-label" for="t-title">话题标题</label>
            <input class="form-input" id="t-title" name="title" maxlength="80" placeholder="例如：Stripe 个人开发者怎么过审？" required />
          </div>
          <div class="form-field">
            <label class="form-label" for="t-desc">补充说明（可选）</label>
            <textarea class="form-textarea" id="t-desc" name="description" maxlength="500" placeholder="想了解的具体问题、场景"></textarea>
          </div>
          <div style="display:flex; align-items:center; gap:var(--space-3);">
            <button class="btn btn--primary" type="submit">提交话题</button>
            <span id="msg" style="font-size:var(--font-size-13); color:var(--color-danger);"></span>
          </div>
        </form>
      ) : (
        <div class="card" style="margin-bottom:var(--space-6); text-align:center; font-size:var(--font-size-14); color:var(--color-text-muted);">
          <a href="/auth/login">登录</a> 后可以提交话题和投票。
        </div>
      )
    }

    <section id="list" style="display:flex; flex-direction:column; gap:var(--space-3);">
      {
        list.length ? (
          list.map((t) => <TopicCard topic={t} loggedIn={!!user} />)
        ) : (
          <div class="card" style="text-align:center; color:var(--color-text-muted); font-size:var(--font-size-14); padding-block:var(--space-8);">
            还没有话题，成为第一个提交者。
          </div>
        )
      }
    </section>
  </div>

  <script define:vars={{ loggedIn: !!user }}>
    // 乐观更新：先改数字再发请求，失败回滚
    document.querySelectorAll('.vote-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!loggedIn) {
          location.href = '/auth/login';
          return;
        }
        const id = btn.dataset.id;
        const countEl = document.querySelector(`[data-count="${id}"]`);
        const before = parseInt(countEl?.textContent || '0', 10);
        const wasVoted = btn.classList.contains('vote-btn--voted');
        const optimistic = wasVoted ? Math.max(0, before - 1) : before + 1;

        btn.classList.toggle('vote-btn--voted', !wasVoted);
        if (countEl) countEl.textContent = String(optimistic);
        btn.disabled = true;

        try {
          const res = await fetch(`/api/topics/${id}/vote`, { method: 'POST' }).then((r) => r.json());
          if (res.ok) {
            if (countEl) countEl.textContent = String(res.voteCount);
            btn.classList.toggle('vote-btn--voted', !!res.voted);
          } else {
            // 回滚
            btn.classList.toggle('vote-btn--voted', wasVoted);
            if (countEl) countEl.textContent = String(before);
            if (res.error) alert(res.error);
          }
        } catch {
          btn.classList.toggle('vote-btn--voted', wasVoted);
          if (countEl) countEl.textContent = String(before);
        } finally {
          btn.disabled = false;
        }
      });
    });

    const form = document.getElementById('newTopic');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const msg = document.getElementById('msg');
        const btn = form.querySelector('button[type="submit"]');
        btn.disabled = true;
        msg.textContent = '';
        try {
          const res = await fetch('/api/topics', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              title: form.title.value.trim(),
              description: form.description.value.trim(),
            }),
          }).then((r) => r.json());
          if (res.ok) {
            location.reload();
          } else {
            msg.textContent = res.error || '提交失败';
          }
        } catch {
          msg.textContent = '网络异常，请稍后重试';
        } finally {
          btn.disabled = false;
        }
      });
    }
  </script>
</BaseLayout>
