---
const links = [
  { href: '/articles', label: '全部文章' },
  { href: '/topics', label: '话题征集' },
  { href: '/tools', label: '工具推荐' },
  { href: '/search', label: '全站搜索' },
];
---
<footer style="margin-top:var(--space-12); padding-block:var(--space-8); border-top:1px solid var(--color-border); background-color:var(--color-surface); font-size:var(--font-size-13); color:var(--color-text-muted);">
  <div class="container" style="display:flex; flex-wrap:wrap; justify-content:space-between; gap:var(--space-4);">
    <div>
      <div style="font-weight:600; color:var(--color-text); margin-bottom:var(--space-1);">ChatSI · si.kittywizards.com</div>
      <div>AI 与云服务的实战内容、工具导航与话题共创社区。</div>
    </div>
    <nav style="display:flex; flex-wrap:wrap; gap:var(--space-4);" aria-label="页脚导航">
      {links.map((l) => <a href={l.href} class="link-underline">{l.label}</a>)}
    </nav>
  </div>
</footer>
