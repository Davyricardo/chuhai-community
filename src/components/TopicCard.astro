---
import type { Topic } from '../db/schema';

interface Props {
  topic: Topic;
  loggedIn: boolean;
}
const { topic, loggedIn } = Astro.props;
const statusLabel: Record<string, string> = { open: '征集中', planned: '规划中', done: '已完成' };
---
<article class="card" style="display:flex; gap:var(--space-4); align-items:flex-start;" data-topic-id={topic.id}>
  <button
    class="vote-btn"
    type="button"
    data-id={topic.id}
    aria-label={loggedIn ? '投票或取消投票' : '登录后可投票'}
    title={loggedIn ? '投票 / 取消投票' : '登录后可投票'}
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m5 15 7-7 7 7"></path>
    </svg>
    <span class="vote-btn__count" data-count={topic.id}>{topic.voteCount}</span>
  </button>

  <div style="flex:1; min-width:0;">
    <h3 style="margin:0 0 var(--space-1); font-size:var(--font-size-16); font-weight:600; line-height:var(--leading-snug);">
      {topic.title}
      {topic.status !== 'open' && <span class={`badge badge--${topic.status}`} style="margin-left:var(--space-2);">{statusLabel[topic.status] || topic.status}</span>}
    </h3>
    {topic.description ? (
      <p style="margin:0; font-size:var(--font-size-14); color:var(--color-text-secondary); line-height:var(--leading-normal); white-space:pre-wrap;">
        {topic.description}
      </p>
    ) : null}
  </div>
</article>
