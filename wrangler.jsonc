{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuhai-community",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuhai-db",
      "database_id": "REPLACE_WITH_D1_ID"
    }
  ]
}
