{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chuhai-community",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kittywizards.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kittywizards.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chuhai-db",
      "database_id": "4dbf7dbf-915e-4278-84a2-75d29ab36747"
    }
  ]
}
